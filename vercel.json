{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/skins",
      "destination": "/cosmetics",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/cubeon-bench/:path*",
      "destination": "/benchmarks",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "services": {
    "website": {
      "root": "web",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "functions": {
        "api/release.mjs": {
          "maxDuration": 15
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
